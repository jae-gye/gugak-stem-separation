# --- Python / uv ---
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# --- data/ is a REAL dir in the repo; track light metadata/ + eda/ (CSV/parquet),
#     but NEVER track the dataset symlinks (huge audio living in ~/storage).
#     Leading slash anchors to repo root so src/data/ is unaffected. ---
/data/gugak_ensemble_71955
/data/gugak_solo_71470

# --- figs/: generated plots (regenerable from the notebook/scripts that emit them) ---
figs/*.png

# --- data/eda/: QC tables moved to manifests/ (2026-07-27); anything left here is
#     scratch EDA output, disk-only ---
data/eda/*.csv

# --- experiment outputs ---
wandb/
checkpoints/
outputs/
*.log

# --- notebooks: source tracked (outputs auto-stripped by nbstripout); ignore
#     generated images so binaries stay out of a public repo ---
notebooks/*.png

# --- experiments/: track light data (parquet/csv) + notes; never track figures
#     (regenerable from the tracked metrics + script — keeps binaries out of git) ---
experiments/**/*.png

# --- OS / editor ---
.DS_Store

# --- Claude Code: per-machine settings (permissions, local overrides).
#     .claude/settings.json (shared, checked in) is NOT ignored — only the local twin. ---
.claude/settings.local.json

# NOTE: uv.lock IS committed (reproducible env) — do not ignore it.
# NOTE: manifests/*.parquet ARE committed (frozen splits) — do not ignore them.
#       CSV twins are committed case-by-case (size call, see CLAUDE.md). These are
#       all 16k-row tables: not meaningfully diff-able, so parquet is the source and
#       the csv stays on-disk-only for eyeballing.
manifests/ingest_manifest.csv
manifests/audio_qc*.csv
manifests/source_manifest.csv
manifests/activity_index.csv

# --- data/activity/: stage-1 envelope blob (146 MB, regenerable by
#     src/data/activity_scan.py); the tracked artifacts are the manifests/ tables ---
/data/activity/
